# SecureAuth Environment Configuration Example
# Copy this file to ".env" for local development and fill in values.
# NEVER commit your actual ".env" file or production secret keys.

# Generate a strong secret key with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Application environment: "development" or "production"
FLASK_ENV=development
FLASK_DEBUG=0

# Set to "true" in HTTPS production deployments; keep "false" for local HTTP testing
SESSION_COOKIE_SECURE=false

# Inactivity session expiration timeout in minutes
SESSION_LIFETIME_MINUTES=15

# Local SQLite database file path
DATABASE_PATH=instance/secureauth.db

# Rate limiter backend (use Redis URI such as redis://localhost:6379/0 in multi-worker production)
RATELIMIT_STORAGE_URI=memory://

# Enable CSRF protection on state-changing forms
WTF_CSRF_ENABLED=true
